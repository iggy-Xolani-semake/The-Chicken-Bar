# Public browser configuration — safe to expose in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-generated-vapid-public-key

# Server-only configuration — set locally and in Netlify; never commit real values.
# SUPABASE_SERVICE_ROLE_KEY is required by the protected push and review-moderation API routes.
VAPID_PRIVATE_KEY=your-generated-vapid-private-key
VAPID_SUBJECT=mailto:info@your-domain.example
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ORDER_PUSH_WEBHOOK_SECRET=generate-a-long-random-secret-for-the-supabase-webhook
